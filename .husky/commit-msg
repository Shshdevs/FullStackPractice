#!/bin/sh

commit_msg_file="$1"

first_line=$(grep -v '^[[:space:]]*#' "$commit_msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

if [ -z "$first_line" ]; then
  echo "❌ Commit message is empty"
  exit 1
fi

if echo "$first_line" | grep -q '^[[:space:]]'; then
  echo "❌ Commit message must not start with spaces"
  echo "Current: \"$first_line\""
  exit 1
fi

if echo "$first_line" | grep -q '[[:space:]]$'; then
  echo "❌ Commit message must not end with spaces"
  echo "Current: \"$first_line\""
  exit 1
fi

if echo "$first_line" | grep -q '[[:space:]][[:space:]]'; then
  echo "❌ Commit message must not contain multiple spaces in a row"
  echo "Current: \"$first_line\""
  exit 1
fi

if echo "$first_line" | grep -q '\.\.'; then
  echo "❌ Commit message must not contain repeated dots"
  echo "Current: \"$first_line\""
  exit 1
fi

if echo "$first_line" | grep -q '\.$'; then
  echo "❌ Commit message must not end with a dot"
  echo "Current: \"$first_line\""
  exit 1
fi

exit 0