{
  "name": "@fullstackpractice/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "ts-node-dev --rs ./src/index.ts",
    "build": "rimraf ./dist && tsc --build ./tsconfig.json",
    "start": "node ./dist/index.js",
    "prettify": "prettier --cache --write '{src/**/*,*}.{ts,js,json,yml}' '!**/{node_modules, dist}/**/*'",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache .",
    "types": "tsc --noEmit --project ./tsconfig.json"
  },
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "inlineSources": true,
    "allowJs": false,
    "skipLibCheck": true,
    "isolatedModules": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "dependencies": {
    "@trpc/server": "^11.17.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.2",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0"
  }
}
