{
  "name": "fullstackpractice",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "b": "pnpm --filter @fullstackpractice/backend",
    "w": "pnpm --filter @fullstackpractice/webapp",
    "lint": "concurrently 'pnpm b lint' 'pnpm w lint'",
    "types": "concurrently 'pnpm b types' 'pnpm w types'",
    "prettify": "concurrently 'pnpm b prettify' 'pnpm w prettify'",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.4",
    "prettier": "3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "5.7.3",
    "typescript-eslint": "^8"
  }
}
